#pragma once

/**
 * @file Version.hpp
 * @brief OpenModel version, as configured in CMake.
 *
 * This header is generated by CMake from `cmake/Version.hpp.in`; do not edit it.
 * The version is set once, with the `OPENMODEL_VERSION` CMake option (`MAJOR.MINOR.PATCH`),
 * and reaches the installed CMake package, the macros below and the runtime functions.
 *
 * The macros describe the headers a program was compiled against. OpenModel::version() and
 * OpenModel::versionString() describe the library that is actually linked, which can differ
 * when a program built against one version loads another shared library.
 */

/** @brief Major version number. */
#define OPENMODEL_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
/** @brief Minor version number (0-99). */
#define OPENMODEL_VERSION_MINOR @PROJECT_VERSION_MINOR@
/** @brief Patch version number (0-99). */
#define OPENMODEL_VERSION_PATCH @PROJECT_VERSION_PATCH@
/** @brief Version as a single comparable integer: `major * 10000 + minor * 100 + patch`. */
#define OPENMODEL_VERSION_NUMBER \
    (OPENMODEL_VERSION_MAJOR * 10000 + OPENMODEL_VERSION_MINOR * 100 + OPENMODEL_VERSION_PATCH)
/** @brief Version as a string literal, `"MAJOR.MINOR.PATCH"`. */
#define OPENMODEL_VERSION_STRING "@PROJECT_VERSION@"

namespace OpenModel {

/** @brief The three numeric components of a version. */
struct Version {
    int major; ///< Major version number.
    int minor; ///< Minor version number.
    int patch; ///< Patch version number.
};

/**
 * @brief Version of the OpenModel library that is linked into the running program.
 * @return The numeric version the library was built with.
 */
Version version() noexcept;

/**
 * @brief Version of the linked OpenModel library as text.
 * @return A string with static storage duration, in the form `"MAJOR.MINOR.PATCH"`.
 */
const char* versionString() noexcept;

} // namespace OpenModel
